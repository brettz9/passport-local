{
  "compilerOptions": {
    "lib": ["ESNext"],
    "types": ["chai", "mocha"],
    "target": "ES2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true
  },
  "include": ["lib/**/*.js", "*.js", "test/**/*.js"],
  "exclude": ["node_modules"]
}
