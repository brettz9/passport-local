{
  "name": "@passport-next/passport-local",
  "version": "2.1.0",
  "type": "module",
  "exports": {
    "types": "./dist/index.d.ts",
    "default": "./lib/index.js"
  },
  "description": "Local username and password authentication strategy for Passport.",
  "keywords": [
    "express",
    "connect",
    "passport",
    "local",
    "auth",
    "authn",
    "authentication",
    "username",
    "password"
  ],
  "author": {
    "name": "Passport Next Developers",
    "url": "https://github.com/orgs/passport-next/people"
  },
  "contributors": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/passport-next/passport-local.git"
  },
  "bugs": "https://github.com/passport-next/passport-local/issues",
  "license": "MIT",
  "homepage": "https://github.com/passport-next/passport-local",
  "dependencies": {
    "@passport-next/http-types": "^0.2.0",
    "@passport-next/passport-strategy": "^2.3.0",
    "@passport-next/passport-types": "^0.3.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@passport-next/chai-passport-strategy": "^3.0.0",
    "@passport-next/passport": "^3.1.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "coveralls": "^3.1.1",
    "eslint": "^10.8.1",
    "eslint-config-ash-nazg": "^42.3.1",
    "http-server": "^14.1.1",
    "jsdoc": "^4.0.5",
    "mocha": "^11.8.0",
    "nunjucks": "^3.2.4",
    "open-cli": "^9.0.0"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "prepublishOnly": "pnpm build && pnpm tsc",
    "tsc": "tsc",
    "attw": "attw --pack . --profile esm-only node16",
    "build": "tsc -p tsconfig-prod.json && pnpm attw",
    "templates": "node ./templates/gen.js",
    "init-new-project": "node ./templates/gen --init",
    "start": "http-server -p 8004",
    "build-docs": "rm -rf docs/jsdoc/*;jsdoc --pedantic -c docs/jsdoc-config.js lib",
    "open-docs": "open-cli http://localhost:8004/docs/jsdoc/ && npm start",
    "lint": "eslint --max-warnings 0 --ext js,cjs,md,html .",
    "lintfix": "eslint --ext js,cjs,md,html . --fix",
    "mocha": "mocha --reporter spec --require ./test/bootstrap/node.js test/*.test.js test/**/*.test.js",
    "test": "c8 --report-dir=var/coverage --reporter=lcov --reporter=text npm run mocha",
    "coveralls": "c8 report --report-dir=var/coverage --reporter=text-lcov | coveralls"
  }
}
